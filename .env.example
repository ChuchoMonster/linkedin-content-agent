# Copy this file to .env and fill in real values. Never commit .env.

# --- Buffer (scheduling) ------------------------------------------------------
# API key from Buffer's settings -> API page
BUFFER_ACCESS_TOKEN="your-buffer-access-token"
# Buffer GraphQL endpoint (the legacy REST API rejects current keys)
BUFFER_API_URL="https://api.buffer.com"
# Look these up with the account { organizations } and channels GraphQL queries
BUFFER_ORGANIZATION_ID="your-buffer-org-id"
BUFFER_LINKEDIN_CHANNEL_ID="your-linkedin-channel-id"

# --- Carousel hosting (publish_asset.py) --------------------------------------
# Local checkout of a static site deployed with the Netlify CLI
ASSET_SITE_DIR="~/path/to/your-static-site"
# The site's publish directory, relative to ASSET_SITE_DIR
ASSET_PUBLISH_DIR="site"
# Public https URL that serves <ASSET_PUBLISH_DIR>/assets/carousels
ASSET_BASE_URL="https://your-site.example.com/assets/carousels"

# --- Optional -----------------------------------------------------------------
# KIE.ai, for photographic imagery only (never for frames with text)
KIE_API_KEY="your-kie-api-key"
KIE_API_URL="https://api.kie.ai/api/v1"

# Read from the shell environment, not this file:
#   CHROME_PATH           Chrome binary for render_carousel.py (default: macOS Chrome)
#   AGENT_HOME            repo path for run_daily.sh (default: the script's directory)
#   CLAUDE_MODEL          model for the daily run (default: claude-opus-5)
#   CLAUDE_FALLBACK_MODEL fallback model (default: claude-sonnet-5)
